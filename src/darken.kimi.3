/*
 * darken.h — single-header entity/state machine library
 *
 * USAGE
 *   In ONE .c file:
 *       #define DARKEN_IMPLEMENTATION
 *       #include "darken.h"
 *
 *   In all other files:
 *       #include "darken.h"
 *
 * DEPENDS ON
 *   Nothing.
 *
 * DESIGN
 *   Fixed pool. User provides an array of entity pointers.
 *   No malloc, no dynamic growth, no external dependencies.
 *
 * MEMORY LAYOUT
 *   items[0 .. pause_count-1]     → paused entities
 *   items[pause_count .. count-1] → active entities
 *   items[count .. capacity-1]    → free slots
 *
 * STATE MACHINE CONTRACT
 *   A state function receives its entity's data[] and returns:
 *
 *     DE_STATE_LOOP    → keep current state, run again next frame
 *     DE_STATE_PAUSE   → freeze entity (moved to paused zone immediately)
 *     DE_STATE_DELETE  → destroy entity immediately
 *     any other fn ptr → transition to that state next frame
 *
 * NOTES
 *   - PAUSE inside de_manager_update may skip one entity for one frame
 *     (swap in reverse iteration). Use de_pause_matching after the loop
 *     if you need frame-perfect batch pausing.
 *   - data[] is a byte FAM. The user controls payload size and alignment
 *     by how they allocate the entity structs.
 *
 * LICENSE
 *   Public domain — no warranty.
 */

#ifndef DARKEN_H
#define DARKEN_H

#include <stdint.h>

/* ============================================================
 * MACRO HELPERS
 * ============================================================ */

#define DE_STMT(CODE)   do { CODE } while (0)

#define DE_EXPR(INIT, VAR, CODE)  \
    ({ __auto_type VAR = (INIT); CODE VAR; })

/* ============================================================
 * STATE
 * ============================================================ */

typedef void *(*de_state_fn)(void *data);

#define DE_STATE_DELETE  ((de_state_fn)0)
#define DE_STATE_LOOP    ((de_state_fn)1)
#define DE_STATE_PAUSE   ((de_state_fn)2)

#define de_state_is_deleted(S)  ((S) == DE_STATE_DELETE)
#define de_state_is_loop(S)     ((S) == DE_STATE_LOOP)
#define de_state_is_pause(S)    ((S) == DE_STATE_PAUSE)
#define de_state_is_active(S)   ((uintptr_t)(S) > (uintptr_t)DE_STATE_PAUSE)

/* ============================================================
 * ENTITY
 * ============================================================ */

typedef struct de_manager de_manager;

typedef struct de_entity
{
    de_state_fn  state;
    de_state_fn  on_destroy;
    de_manager  *manager;
    uint16_t     slot;
    uint16_t     tag;
    uint8_t      data[];
} de_entity;

/* ---- Zone predicates ---- */
#define de_entity_is_paused(E)  ((E)->slot <  (E)->manager->pause_count)
#define de_entity_is_active(E)  ((E)->slot >= (E)->manager->pause_count && \
                                 (E)->slot <  (E)->manager->count)
#define de_entity_is_dead(E)    ((E)->slot >= (E)->manager->count)

/* ---- Accessors ---- */
#define de_entity_data(E, TYPE)   ((TYPE *)((E)->data))
#define de_entity_manager(E)      ((E)->manager)

/* ============================================================
 * MANAGER
 * ============================================================ */

struct de_manager
{
    de_entity **items;
    uint16_t    count;
    uint16_t    capacity;
    uint16_t    pause_count;
};

#define de_manager_count(M)         ((M)->count)
#define de_manager_count_active(M)  ((M)->count - (M)->pause_count)
#define de_manager_count_paused(M)  ((M)->pause_count)

/* ============================================================
 * MANAGER — lifecycle
 * ============================================================ */

/*
 * de_manager_init(M, ITEMS_ARRAY, CAPACITY)
 *   ITEMS_ARRAY — de_entity* pool[CAPACITY], provided by user
 *   CAPACITY    — max entities (fixed)
 *
 * The manager only wires to the array. Allocation is user responsibility.
 */
#define de_manager_init(M, ITEMS_ARRAY, CAPACITY)                       \
    DE_STMT(                                                            \
        (M)->items       = (ITEMS_ARRAY);                               \
        (M)->capacity    = (CAPACITY);                                  \
        (M)->count       = 0;                                           \
        (M)->pause_count = 0;                                           \
    )

#define de_manager_end(M)                                               \
    DE_STMT(                                                            \
        (M)->items       = NULL;                                        \
        (M)->capacity    = 0;                                           \
        (M)->count       = 0;                                           \
        (M)->pause_count = 0;                                           \
    )

/* ============================================================
 * ENTITY — registration
 * ============================================================
 *
 * The user allocates entities. The manager only registers them.
 */

/*
 * de_manager_add(M, ENTITY, TAG)
 *   Registers an existing entity into the manager.
 *   Returns the entity, or NULL if the manager is full.
 */
#define de_manager_add(M, ENTITY, TAG)                                  \
    DE_EXPR((de_entity *)(ENTITY), _e,                                  \
        if (_e && (M)->count < (M)->capacity)                           \
        {                                                               \
            _e->manager    = (M);                                       \
            _e->slot       = (M)->count++;                              \
            _e->tag        = (TAG);                                     \
            _e->state      = DE_STATE_LOOP;                             \
            _e->on_destroy = NULL;                                      \
            (M)->items[_e->slot] = _e;                                  \
        }                                                               \
        else                                                            \
            _e = NULL;                                                  \
    )

/* ============================================================
 * INTERNAL — slot swap
 * ============================================================ */

#define _de_swap_slot(E, DST)                                           \
    DE_STMT(                                                            \
        uint16_t _src = (E)->slot;                                      \
        uint16_t _dst = (DST);                                          \
        if (_src != _dst)                                               \
        {                                                               \
            de_entity **_arr = (E)->manager->items;                     \
            _arr[_src]       = _arr[_dst];                              \
            _arr[_src]->slot = _src;                                    \
            _arr[_dst]       = (E);                                     \
            (E)->slot        = _dst;                                    \
        }                                                               \
    )

/* ============================================================
 * ENTITY — state transitions
 * ============================================================ */

#define de_entity_pause(E)                                              \
    DE_STMT(                                                            \
        if (de_entity_is_active(E))                                     \
            _de_swap_slot(E, (E)->manager->pause_count++);              \
    )

#define de_entity_resume(E)                                             \
    DE_STMT(                                                            \
        if (de_entity_is_paused(E))                                     \
            _de_swap_slot(E, --(E)->manager->pause_count);              \
    )

#define de_entity_kill(E)                                               \
    DE_STMT(                                                            \
        if (!de_entity_is_dead(E))                                      \
        {                                                               \
            (E)->state = DE_STATE_DELETE;                               \
            if ((E)->on_destroy)                                        \
                (E)->state = (E)->on_destroy((E)->data);                \
            if (de_state_is_deleted((E)->state))                        \
            {                                                           \
                if (de_entity_is_paused(E))                             \
                    _de_swap_slot(E, --(E)->manager->pause_count);      \
                _de_swap_slot(E, --(E)->manager->count);                \
            }                                                           \
        }                                                               \
    )

#define de_entity_retag(E, NEW_TAG)      ((E)->tag = (NEW_TAG))
#define de_entity_set_state(E, S)        ((E)->state = (S))
#define de_entity_set_destroy(E, F)      ((E)->on_destroy = (F))

/* ============================================================
 * MANAGER — bulk operations
 * ============================================================ */

#define de_manager_pause_all(M)   ((M)->pause_count = (M)->count)
#define de_manager_resume_all(M)  ((M)->pause_count = 0)

#define de_manager_reset(M)                                             \
    DE_STMT(                                                            \
        uint16_t _i = (M)->count;                                       \
        while (_i--)                                                    \
        {                                                               \
            de_entity *_e = (M)->items[_i];                             \
            if (_e->on_destroy)                                         \
                _e->on_destroy(_e->data);                               \
        }                                                               \
        (M)->count       = 0;                                           \
        (M)->pause_count = 0;                                           \
    )

#define de_manager_kill_all(M)  de_manager_reset(M)

/* ============================================================
 * ITERATION
 * ============================================================
 *
 * Variables exposed inside BODY:
 *   E    de_entity*    current entity
 *   I    uint16_t      current slot index
 */

#define de_for_active(M, BODY)                                          \
    DE_STMT(                                                            \
        uint16_t _pc = (M)->pause_count;                                \
        uint16_t I   = (M)->count;                                      \
        de_entity **_arr = (M)->items;                                  \
        while (I-- > _pc)                                               \
        {                                                               \
            de_entity *E = _arr[I];                                     \
            BODY;                                                       \
        }                                                               \
    )

#define de_for_paused(M, BODY)                                          \
    DE_STMT(                                                            \
        uint16_t I = (M)->pause_count;                                  \
        de_entity **_arr = (M)->items;                                  \
        while (I--)                                                     \
        {                                                               \
            de_entity *E = _arr[I];                                     \
            BODY;                                                       \
        }                                                               \
    )

#define de_for_all(M, BODY)                                             \
    DE_STMT(                                                            \
        uint16_t I = (M)->count;                                        \
        de_entity **_arr = (M)->items;                                  \
        while (I--)                                                     \
        {                                                               \
            de_entity *E = _arr[I];                                     \
            BODY;                                                       \
        }                                                               \
    )

/* ============================================================
 * BULK OPERATIONS — direction-safe, no buffer needed
 * ============================================================
 *
 * These iterate in the direction that makes the operation safe:
 *   kill    → reverse (swap to end, count--)
 *   pause   → forward (swap to front, pause_count++)
 *   resume  → reverse in paused zone (swap to front, pause_count--)
 */

#define de_kill_matching(M, FILTER)   de_for_all(M,    { if (FILTER) de_entity_kill(E); })
#define de_kill_active(M, FILTER)     de_for_active(M,  { if (FILTER) de_entity_kill(E); })

#define de_pause_matching(M, FILTER)                                    \
    DE_STMT(                                                            \
        uint16_t I = (M)->pause_count;                                  \
        uint16_t _n = (M)->count;                                       \
        while (I < _n)                                                  \
        {                                                               \
            de_entity *E = (M)->items[I];                               \
            if (FILTER) de_entity_pause(E);                             \
            I++;                                                        \
        }                                                               \
    )

#define de_resume_matching(M, FILTER)                                   \
    DE_STMT(                                                            \
        uint16_t I = (M)->pause_count;                                  \
        while (I--)                                                     \
        {                                                               \
            de_entity *E = (M)->items[I];                               \
            if (FILTER) de_entity_resume(E);                            \
        }                                                               \
    )

/* ============================================================
 * TAG SHORTCUTS
 * ============================================================ */

#define de_kill_by_tag(M, TAG)    de_kill_active(M,   E->tag == (TAG))
#define de_pause_by_tag(M, TAG)   de_pause_matching(M, E->tag == (TAG))
#define de_resume_by_tag(M, TAG)  de_resume_matching(M, E->tag == (TAG))

/* ============================================================
 * FIND
 * ============================================================ */

#define de_find_first(M, TAG)                                           \
    DE_EXPR((de_entity *)NULL, _found,                                  \
        de_for_all(M, {                                                 \
            if (E->tag == (TAG)) { _found = E; break; }                 \
        });                                                             \
    )

#define de_find_all(M, TAG, BODY)                                       \
    de_for_all(M, { if (E->tag == (TAG)) { BODY; } })

/* ============================================================
 * UPDATE LOOP
 * ============================================================
 *
 * Single pass, reverse order.
 * KILL is safe (reverse iteration). PAUSE is handled inline;
 * the displaced entity may skip one frame — use de_pause_matching
 * after the loop if you need guaranteed frame-perfect pausing.
 */

#define de_manager_update(M)                                            \
    de_for_active(M, {                                                  \
        de_state_fn _st = E->state;                                     \
        if (de_state_is_active(_st))                                    \
        {                                                               \
            de_state_fn _next = _st(E->data);                           \
            if (!de_state_is_loop(_next))                               \
                E->state = _next;                                       \
        }                                                               \
        else if (de_state_is_pause(_st))   de_entity_pause(E);         \
        else if (de_state_is_deleted(_st)) de_entity_kill(E);          \
    })

#endif /* DARKEN_H */










#define MAX_ENEMIES 32

typedef struct { int hp, x, y; } EnemyData;

/* Pool: el usuario controla la memoria */
static struct {
    de_entity base;
    EnemyData payload;
} enemy_pool[MAX_ENEMIES];

static de_entity *enemy_items[MAX_ENEMIES];

int main(void)
{
    de_manager mgr;
    de_manager_init(&mgr, enemy_items, MAX_ENEMIES);

    /* Registrar una entidad del pool */
    de_manager_add(&mgr, &enemy_pool[0].base, TAG_ENEMY);
    de_entity_set_state(&enemy_pool[0].base, s_enemy_idle);

    /* Loop */
    for (;;)
    {
        de_manager_update(&mgr);

        /* Pausar todos los enemigos congelados, garantizado */
        de_pause_by_tag(&mgr, TAG_ENEMY_FROZEN);
    }

    de_manager_reset(&mgr);
    return 0;
}