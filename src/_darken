    } enemy_pool[MAX_ENEMIES];

    static de_entity *enemy_ptrs[MAX_ENEMIES];

    de_manager mgr;
    de_manager_init(&mgr, enemy_ptrs, MAX_ENEMIES, sizeof(Enemy));

