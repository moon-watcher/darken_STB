/*
 * darken.h — single-header entity/state machine library (STB-style)
 *
 * USAGE
 *   In ONE .c file:
 *       #define STB_DARKEN_IMPLEMENTATION
 *       #include "darken.h"
 *
 *   In all other files:
 *       #include "darken.h"
 *
 * MEMORY MODEL
 *   Zero malloc. User provides a pre-allocated entity array and a pointer
 *   array. The manager only holds pointers — no ownership of entity memory.
 *
 *   Typical setup:
 *
 *       static struct { de_entity base; MyData data; } pool[MAX];
 *       static de_entity *ptrs[MAX];
 *       de_manager mgr;
 *       de_manager_init(&mgr, ptrs, MAX);
 *       de_manager_add(&mgr, &pool[0].base, MY_TAG);
 *
 * STATE CONTRACT
 *   A state function receives entity->data and returns:
 *     de_state_loop    → stay in this state
 *     de_state_pause   → move to paused zone
 *     de_state_delete  → call destructor and remove
 *     any fn ptr       → transition to that state next frame
 *
 * LAYOUT
 *   items:  [ paused: 0..pause_index | active: pause_index..count ]
 *
 * ITERATION SAFETY
 *   de_manager_iterate / de_manager_iterateAll:
 *     Safe with de_entity_delete (reverse order — swapped entity
 *     was already processed).
 *     NOT safe with de_entity_pause/resume — use de_manager_apply.
 *
 *   de_manager_apply / de_manager_applyAll:
 *     Always safe with delete/pause/resume — collects first, acts after.
 *
 * LICENSE
 *   Public domain — no warranty.
 */

#ifndef DARKEN_H
#define DARKEN_H

#include <stdint.h>

/* ============================================================
 * STATE
 * ============================================================ */

typedef void *(*de_state)(void *);

#define de_state_delete  ((de_state)0)
#define de_state_loop    ((de_state)1)
#define de_state_pause   ((de_state)2)

#define de_state_is_deleted(S)  ((S) == de_state_delete)
#define de_state_is_loop(S)     ((S) == de_state_loop)
#define de_state_is_paused(S)   ((S) == de_state_pause)
#define de_state_is_active(S)   ((S) > de_state_pause)

/* ============================================================
 * ENTITY
 * ============================================================ */

typedef struct de_manager de_manager;

typedef struct de_entity
{
    de_state    state;
    de_state    destructor;
    de_manager *manager;
    uint16_t    index;
    uint16_t    tag;
    uint8_t     data[];     /* payload — user is responsible for sizing */
} de_entity;

/* ---- Zone predicates ---- */
#define de_entity_is_paused(E)  ((E)->index <  (E)->manager->pause_index)
#define de_entity_is_active(E)  ((E)->index >= (E)->manager->pause_index && \
                                 (E)->index <  (E)->manager->count)
#define de_entity_is_deleted(E) ((E)->index >= (E)->manager->count)

/* ---- Payload / state access ---- */
#define de_entity_data(E, TYPE)      ((TYPE *)((E)->data))
#define de_entity_set_state(E, S)    ((E)->state = (S))
#define de_entity_set_destroy(E, F)  ((E)->destructor = (F))
#define de_entity_retag(E, TAG)      ((E)->tag = (TAG))

/* ============================================================
 * MANAGER
 * ============================================================ */

struct de_manager
{
    de_entity **items;
    uint16_t    count;
    uint16_t    capacity;
    uint16_t    pause_index;
};

/* ============================================================
 * MANAGER — lifecycle
 * ============================================================ */

/*
 * de_manager_init(M, ARRAY, CAPACITY)
 *   ARRAY    — de_entity* ptrs[CAPACITY] provided by the user
 *   CAPACITY — max number of entities
 */
#define de_manager_init(M, ARRAY, CAPACITY)     \
    do {                                        \
        (M)->items       = (ARRAY);             \
        (M)->capacity    = (CAPACITY);          \
        (M)->count       = 0;                   \
        (M)->pause_index = 0;                   \
    } while (0)

#define de_manager_end(M)                       \
    do {                                        \
        (M)->items       = NULL;                \
        (M)->capacity    = 0;                   \
        (M)->count       = 0;                   \
        (M)->pause_index = 0;                   \
    } while (0)

/* ============================================================
 * ENTITY — creation
 * ============================================================ */

/*
 * de_manager_add(M, ENTITY, TAG)
 *   Registers an existing entity into the manager.
 *   Initializes state to de_state_loop, destructor to NULL.
 *   Returns the entity on success, NULL if full.
 *   Entity data[] is NOT zeroed — user is responsible.
 */
#define de_manager_add(M, ENTITY, TAG)                  \
    ({                                                  \
        de_entity *_e = (ENTITY);                       \
        if ((M)->count < (M)->capacity && _e)           \
        {                                               \
            _e->manager    = (M);                       \
            _e->index      = (M)->count++;              \
            _e->tag        = (TAG);                     \
            _e->state      = de_state_loop;             \
            _e->destructor = NULL;                      \
            (M)->items[_e->index] = _e;                 \
        }                                               \
        else _e = NULL;                                 \
        _e;                                             \
    })

/* ============================================================
 * ITERATION MACROS
 * ============================================================
 *
 * de_manager_iterate(M, CODE)
 *   Active entities only (pause_index..count), reverse order.
 *   pause_index captured once — safe if it changes inside CODE.
 *
 * de_manager_iterateAll(M, CODE)
 *   All entities (0..count), reverse order.
 *
 * Exposed inside CODE:
 *   E    de_entity*    current entity
 *   I    uint16_t      current index (read-only)
 *
 * @note Do not call de_entity_pause/resume inside CODE.
 *       de_entity_delete is safe (reverse order).
 *       Use de_manager_apply for pause/resume.
 */
#define de_manager_iterate(M, CODE)                     \
    do {                                                \
        uint16_t _pc   = (M)->pause_index;             \
        uint16_t I     = (M)->count;                   \
        de_entity **_a = (M)->items;                   \
        while (I-- > _pc)                              \
        {                                               \
            de_entity *E = _a[I];                      \
            CODE;                                       \
        }                                               \
    } while (0)

#define de_manager_iterateAll(M, CODE)                  \
    do {                                                \
        uint16_t I     = (M)->count;                   \
        de_entity **_a = (M)->items;                   \
        while (I--)                                    \
        {                                               \
            de_entity *E = _a[I];                      \
            CODE;                                       \
        }                                               \
    } while (0)

/* ============================================================
 * APPLY MACROS
 * ============================================================
 *
 * de_manager_apply(M, FILTER, ACTION)
 *   Collects active entities matching FILTER, then calls ACTION on each.
 *
 * de_manager_applyAll(M, FILTER, ACTION)
 *   Same, includes paused entities.
 *
 * de_manager_applyTag(M, TAG, ACTION)
 *   Shorthand — applies ACTION to all entities matching tag.
 *
 * Always safe with de_entity_delete, de_entity_pause, de_entity_resume.
 *
 * @param FILTER  Expression using E. Use 1 to match all.
 * @param ACTION  Function or macro: void f(de_entity *).
 *
 * Exposed inside FILTER:
 *   E    de_entity*    current entity being evaluated
 *   I    uint16_t      current index
 */
#define de_manager_apply(M, FILTER, ACTION)                             \
    do {                                                                \
        de_entity *_t[(M)->count + 1];                                  \
        uint16_t   _n = 0;                                              \
        de_manager_iterate(M, { if (FILTER) _t[_n++] = E; });          \
        while (_n--) (ACTION)(_t[_n]);                                  \
    } while (0)

#define de_manager_applyAll(M, FILTER, ACTION)                          \
    do {                                                                \
        de_entity *_t[(M)->count + 1];                                  \
        uint16_t   _n = 0;                                              \
        de_manager_iterateAll(M, { if (FILTER) _t[_n++] = E; });       \
        while (_n--) (ACTION)(_t[_n]);                                  \
    } while (0)

#define de_manager_applyTag(M, TAG, ACTION) \
    de_manager_applyAll(M, E->tag == (TAG), ACTION)

/* ============================================================
 * FIND MACROS
 * ============================================================ */

/*
 * de_manager_findFirst(M, TAG)
 *   Returns first entity with matching tag (all zones), or NULL.
 */
#define de_manager_findFirst(M, TAG)                    \
    ({                                                  \
        de_entity *_f = NULL;                           \
        de_manager_iterateAll(M, {                      \
            if (E->tag == (TAG)) { _f = E; break; }    \
        });                                             \
        _f;                                             \
    })

/*
 * de_manager_findAll(M, TAG, CODE)
 *   Iterates all entities matching tag. Read-only — no delete/pause inside.
 */
#define de_manager_findAll(M, TAG, CODE) \
    de_manager_iterateAll(M, { if (E->tag == (TAG)) { CODE; } })

/* ============================================================
 * COUNT HELPERS
 * ============================================================ */

#define de_manager_count(M)         ((M)->count)
#define de_manager_count_active(M)  ((M)->count - (M)->pause_index)
#define de_manager_count_paused(M)  ((M)->pause_index)

/* ============================================================
 * IMPLEMENTATION
 * ============================================================ */

#ifdef STB_DARKEN_IMPLEMENTATION

static inline void _de_swap_index(de_entity *e, uint16_t dst)
{
    uint16_t src = e->index;
    if (src == dst) return;
    de_entity **items = e->manager->items;
    items[src]        = items[dst];
    items[src]->index = src;
    items[dst]        = e;
    e->index          = dst;
}

void de_entity_pause(de_entity *e)
{
    if (de_entity_is_active(e))
        _de_swap_index(e, e->manager->pause_index++);
}

void de_entity_resume(de_entity *e)
{
    if (de_entity_is_paused(e))
        _de_swap_index(e, --e->manager->pause_index);
}

/*
 * de_entity_delete(e)
 *   Calls destructor if set. If destructor returns de_state_delete
 *   (or is NULL), entity is removed from the manager.
 *   If destructor returns anything else, entity survives.
 */
void de_entity_delete(de_entity *e)
{
    if (de_entity_is_deleted(e))
        return;

    e->state = de_state_delete;

    if (e->destructor)
        e->state = e->destructor(e->data);

    if (de_state_is_deleted(e->state))
    {
        de_entity_resume(e);
        _de_swap_index(e, --e->manager->count);
    }
}

void de_manager_pause_all(de_manager *m)  { m->pause_index = m->count; }
void de_manager_resume_all(de_manager *m) { m->pause_index = 0; }

/*
 * de_manager_reset(m)
 *   Calls each destructor without modifying the list mid-loop,
 *   then clears count and pause_index. Entity memory is NOT freed.
 */
void de_manager_reset(de_manager *m)
{
    uint16_t i = m->count;
    while (i--)
    {
        de_entity *e = m->items[i];
        if (e->destructor)
            e->destructor(e->data);
    }
    m->count       = 0;
    m->pause_index = 0;
}

/*
 * de_manager_update(m)
 *   Calls each active entity's state function, reverse order.
 *   pause_index captured once — entities paused during update
 *   do not affect which entities are processed this frame.
 *
 *   de_entity_delete: SAFE (swapped entity was already processed).
 *   de_entity_pause:  may skip one entity for one frame — acceptable.
 */
void de_manager_update(de_manager *m)
{
    uint16_t    pc    = m->pause_index;   /* capture once */
    uint16_t    i     = m->count;
    de_entity **items = m->items;

    while (i-- > pc)
    {
        de_entity *e = items[i];
        e->index = i;
        de_state st = e->state;

        if (de_state_is_active(st))
        {
            de_state next = st(e->data);
            if (!de_state_is_loop(next))
                e->state = next;
        }
        else if (de_state_is_paused(st))  de_entity_pause(e);
        else if (de_state_is_deleted(st)) de_entity_delete(e);
    }
}

#endif /* STB_DARKEN_IMPLEMENTATION */
#endif /* DARKEN_H */


#define STB_DARKEN_IMPLEMENTATION
#include "darken.h"

/* ---- Tags ---- */
#define TAG_ENEMY  1
#define TAG_BULLET 2

/* ---- Payloads ---- */
typedef struct { int hp; int x; int y; } Enemy;
typedef struct { int x; int y; int vx; } Bullet;

/* ---- States ---- */
static de_state s_enemy_walk(Enemy *data)
{
    data->x += 1;
    if (data->hp <= 0) return de_state_delete;
    return de_state_loop;
}

static de_state s_bullet_move(Bullet *data)
{
    data->x += data->vx;
    if (data->x > 320) return de_state_delete;
    return de_state_loop;
}

/* ---- Pool ---- */
#define MAX_ENEMIES 16
#define MAX_BULLETS 32

static struct { de_entity base; Enemy  payload; } enemy_pool [MAX_ENEMIES];
static struct { de_entity base; Bullet payload; } bullet_pool[MAX_BULLETS];

static de_entity *enemy_ptrs [MAX_ENEMIES];
static de_entity *bullet_ptrs[MAX_BULLETS];

/* ---- Managers ---- */
static de_manager mgr_enemies;
static de_manager mgr_bullets;

/* ---- Helpers ---- */
static de_entity *spawn_enemy(int x, int y, int hp)
{
    /* busca el primer slot libre — fuera del pool activo */
    uint16_t slot = mgr_enemies.count;
    if (slot >= MAX_ENEMIES) return NULL;

    Enemy *d  = &enemy_pool[slot].payload;
    d->x      = x;
    d->y      = y;
    d->hp     = hp;

    de_entity *e = de_manager_add(&mgr_enemies, &enemy_pool[slot].base, TAG_ENEMY);
    de_entity_set_state(e, (de_state)s_enemy_walk);
    return e;
}

static de_entity *spawn_bullet(int x, int y, int vx)
{
    uint16_t slot = mgr_bullets.count;
    if (slot >= MAX_BULLETS) return NULL;

    Bullet *d = &bullet_pool[slot].payload;
    d->x      = x;
    d->y      = y;
    d->vx     = vx;

    de_entity *e = de_manager_add(&mgr_bullets, &bullet_pool[slot].base, TAG_BULLET);
    de_entity_set_state(e, (de_state)s_bullet_move);
    return e;
}

/* ---- Main ---- */
int main(void)
{
    de_manager_init(&mgr_enemies, enemy_ptrs,  MAX_ENEMIES);
    de_manager_init(&mgr_bullets, bullet_ptrs, MAX_BULLETS);

    /* spawn */
    de_entity *enemy = spawn_enemy(100, 50, 3);
    spawn_bullet(0, 50, 4);
    spawn_bullet(0, 60, 6);

    /* pausa todos los bullets */
    de_manager_pause_all(&mgr_bullets);

    /* game loop */
    for (int frame = 0; frame < 10; frame++)
    {
        de_manager_update(&mgr_enemies);
        de_manager_update(&mgr_bullets);
    }

    /* mata al enemigo directamente */
    de_entity_delete(enemy);

    /* mata todos los bullets con tag */
    de_manager_applyTag(&mgr_bullets, TAG_BULLET, de_entity_delete);

    de_manager_end(&mgr_enemies);
    de_manager_end(&mgr_bullets);
    return 0;
}










/*
 * darken.h — single-header entity/manager library (STB-style)
 *
 * USAGE
 *   #include "darken.h" in every file.
 *   All functions are static inline; no separate implementation.
 *
 *   Declare a manager with its own storage:
 *       DE_MANAGER_DECLARE(name, capacity, payload_type);
 *   Then inside a function, initialise it:
 *       DE_MANAGER_INIT(name);
 *
 *   Or manually:
 *       de_manager mgr;
 *       de_entity *ptrs[CAPACITY];
 *       uint8_t storage[CAPACITY * (sizeof(de_entity) + sizeof(Payload))];
 *       de_manager_memory mem = { .items = ptrs, .storage = storage,
 *                                 .capacity = CAPACITY, .bytes = sizeof(Payload) };
 *       de_manager_init(&mgr, &mem, "mgr");
 *
 * LICENSE
 *   Public domain.
 */

#ifndef DARKEN_H
#define DARKEN_H

#include <stdint.h>
#include <stddef.h>

/* ============================================================
 * STATE
 * ============================================================ */

typedef void *(*de_state)(void *);

#define de_state_delete  ((de_state)0)
#define de_state_loop    ((de_state)1)
#define de_state_pause   ((de_state)2)

#define de_state_is_deleted(S) ((S) == de_state_delete)
#define de_state_is_loop(S)    ((S) == de_state_loop)
#define de_state_is_paused(S)  ((S) == de_state_pause)
#define de_state_is_active(S)  ((S) > de_state_pause)

/* ============================================================
 * ENTITY
 * ============================================================ */

typedef struct de_manager de_manager;

typedef struct de_entity {
    de_state    state;
    de_state    destructor;
    de_manager *manager;
    uint16_t    slot;       /* position in manager->items[] */
    uint16_t    tag;        /* user‑defined identifier */
    uint8_t     data[];     /* flexible payload */
} de_entity;

/* ============================================================
 * MANAGER
 * ============================================================ */

struct de_manager {
    de_entity **items;      /* array of pointers (size = capacity) */
    uint16_t    size;       /* number of live entities */
    uint16_t    capacity;   /* max entities */
    uint16_t    pause_index;/* split: paused < pause_index <= active */
    char       *name;       /* optional debug label */
};

/* Memory bundle passed to de_manager_init */
typedef struct de_manager_memory {
    de_entity **items;      /* pointer array, size = capacity */
    void       *storage;    /* raw memory block for all entities */
    uint16_t    capacity;   /* max number of entities */
    uint16_t    bytes;      /* size of each entity's payload (data[]) */
} de_manager_memory;

/* ---- Initialisation ---- */

static inline void de_manager_init(de_manager *mgr,
                                   const de_manager_memory *mem,
                                   const char *name)
{
    mgr->items       = mem->items;
    mgr->size        = 0;
    mgr->capacity    = mem->capacity;
    mgr->pause_index = 0;
    mgr->name        = (char*)name;

    size_t ent_size = sizeof(de_entity) + mem->bytes;
    for (uint16_t i = 0; i < mem->capacity; ++i) {
        mem->items[i] = (de_entity*)((uint8_t*)mem->storage + i * ent_size);
    }
}

/* ---- Entity creation ---- */

static inline de_entity *de_manager_new(de_manager *mgr)
{
    if (mgr->size >= mgr->capacity)
        return NULL;

    de_entity *e = mgr->items[mgr->size];
    e->manager    = mgr;
    e->slot       = mgr->size;
    e->state      = (de_state)0;
    e->destructor = NULL;
    e->tag        = 0;

    ++mgr->size;
    return e;
}

/* ---- Internal swap helper ---- */

static inline void de_entity_swap(de_entity *a, de_entity *b)
{
    de_manager *mgr = a->manager;
    uint16_t i = a->slot;
    uint16_t j = b->slot;

    mgr->items[i] = b;
    b->slot = i;
    mgr->items[j] = a;
    a->slot = j;
}

/* ---- Pause / Resume / Delete ---- */

static inline void de_entity_pause(de_entity *e)
{
    de_manager *mgr = e->manager;
    if (e->slot >= mgr->pause_index && e->slot < mgr->size) {
        de_entity *other = mgr->items[mgr->pause_index];
        de_entity_swap(e, other);
        ++mgr->pause_index;
    }
}

static inline void de_entity_resume(de_entity *e)
{
    de_manager *mgr = e->manager;
    if (e->slot < mgr->pause_index) {
        --mgr->pause_index;
        de_entity *other = mgr->items[mgr->pause_index];
        de_entity_swap(e, other);
    }
}

static inline void de_entity_delete(de_entity *e)
{
    de_manager *mgr = e->manager;
    if (e->slot >= mgr->size)
        return;

    e->state = de_state_delete;
    if (e->destructor)
        e->state = e->destructor(e->data);

    if (de_state_is_deleted(e->state)) {
        if (e->slot < mgr->pause_index) {
            --mgr->pause_index;
            de_entity *other = mgr->items[mgr->pause_index];
            de_entity_swap(e, other);
        }
        --mgr->size;
        if (e->slot != mgr->size) {
            de_entity *last = mgr->items[mgr->size];
            de_entity_swap(e, last);
        }
    }
}

/* ---- Manager bulk operations ---- */

static inline void de_manager_pause(de_manager *mgr)
{
    mgr->pause_index = mgr->size;
}

static inline void de_manager_resume(de_manager *mgr)
{
    mgr->pause_index = 0;
}

static inline void de_manager_reset(de_manager *mgr)
{
    mgr->pause_index = 0;
    while (mgr->size) {
        de_entity *e = mgr->items[mgr->size - 1];
        de_entity_delete(e);
    }
}

/* ---- Update ---- */

static inline void de_entity_update(de_entity *e)
{
    de_state s = e->state;
    if (de_state_is_active(s)) {
        s = s(e->data);
        if (!de_state_is_loop(s))
            e->state = s;
    }
}

static inline void de_manager_update(de_manager *mgr)
{
    uint16_t i = mgr->size;
    while (i-- > mgr->pause_index) {
        de_entity *e = mgr->items[i];
        e->slot = i;
        de_state s = e->state;

        if (de_state_is_active(s))
            de_entity_update(e);
        else if (de_state_is_paused(s))
            de_entity_pause(e);
        else if (de_state_is_deleted(s))
            de_entity_delete(e);
    }
}

/* ============================================================
 * ITERATION MACROS
 * ============================================================ */

#define de_manager_iterate(M, CODE) \
    _de_manager_iterate(M, (M)->pause_index, CODE)

#define de_manager_iterateAll(M, CODE) \
    _de_manager_iterate(M, 0, CODE)

#define _de_manager_iterate(M, LIMIT, CODE) \
    do { \
        uint16_t INDEX = (M)->size; \
        if (INDEX > (LIMIT)) { \
            de_entity **ENTITIES = (M)->items; \
            while (INDEX-- > (LIMIT)) { \
                de_entity *ENTITY = ENTITIES[INDEX]; \
                CODE; \
            } \
        } \
    } while (0)

/* ============================================================
 * APPLY MACROS
 * ============================================================ */

#define de_manager_apply(M, F, A)    _de_manager_apply(de_manager_iterate,    M, F, A)
#define de_manager_applyAll(M, F, A) _de_manager_apply(de_manager_iterateAll, M, F, A)

#define _de_manager_apply(ITER, M, FILTER, ACTION) \
    do { \
        uint16_t _cap = (M)->size; \
        de_entity *_targets[_cap + 1]; \
        uint16_t _count = 0; \
        ITER(M, { if (FILTER) _targets[_count++] = ENTITY; }); \
        while (_count--) \
            (ACTION)(_targets[_count]); \
    } while (0)

/* ============================================================
 * CONVENIENCE MACROS
 * ============================================================ */

/*
 * Declare a manager variable with its own pointer array and storage.
 * Use inside a function (or globally, but then you must call DE_MANAGER_INIT
 * before using it).
 */
#define DE_MANAGER_DECLARE(NAME, CAPACITY, PAYLOAD_TYPE) \
    struct { \
        de_manager mgr; \
        de_entity *ptrs[CAPACITY]; \
        uint8_t storage[CAPACITY * (sizeof(de_entity) + sizeof(PAYLOAD_TYPE))]; \
    } NAME;

/*
 * Build a de_manager_memory from a variable declared with DE_MANAGER_DECLARE.
 * This is a compound literal (C99), so it can be used as an expression.
 */
#define DE_MANAGER_MAKE_MEMORY(NAME) \
    (de_manager_memory){ \
        .items    = (NAME).ptrs, \
        .storage  = (NAME).storage, \
        .capacity = (uint16_t)(sizeof((NAME).ptrs) / sizeof((NAME).ptrs[0])), \
        .bytes    = (uint16_t)((sizeof((NAME).storage) / (sizeof((NAME).ptrs) / sizeof((NAME).ptrs[0]))) - sizeof(de_entity)) \
    }

/*
 * Initialise a manager declared with DE_MANAGER_DECLARE.
 * This is a statement that calls de_manager_init with the proper memory bundle.
 */
#define DE_MANAGER_INIT(NAME) \
